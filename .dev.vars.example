NOTION_API_KEY="ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NOTION_DATABASE_ID="00000000000000000000000000000000"
# Filled in after completing the Notion webhook verification handshake
